# Kopie als ".env" speichern und anpassen.

# Anthropic API-Key (empfohlen, von https://console.anthropic.com).
# Wenn leer, nutzt die Pipeline als Fallback die Claude-Code-CLI (`claude -p`)
# über das bestehende Claude-Abo — langsamer, aber ohne Extra-Kosten.
ANTHROPIC_API_KEY=

# Modelle (Standard: claude-opus-4-8). Günstigere Alternative für die
# Fotoanalyse: claude-haiku-4-5 (weniger zuverlässig beim Ablesen der
# Teilenummer) oder claude-sonnet-5 (guter Mittelweg).
AUTOLISTER_VISION_MODEL=claude-opus-4-8
AUTOLISTER_TEXT_MODEL=claude-opus-4-8

# 1 = Browser unsichtbar (headless). Standard 0: Fenster sichtbar,
# weniger Bot-Erkennung durch eBay.
AUTOLISTER_HEADLESS=0

# Port der Upload-Website
AUTOLISTER_WEBAPP_PORT=8790

# Sekunden Ruhe im Eingang, bevor die Verarbeitung startet
AUTOLISTER_SETTLE_SECONDS=25
