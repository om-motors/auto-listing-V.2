# Kopie als ".env" speichern und bei Bedarf anpassen.
# Die Voreinstellungen sind so gewählt, dass alles KOSTENLOS läuft.

# --- Betriebsart -------------------------------------------------------------
#   lokal  Standard und KOSTENLOS. Die in macOS eingebaute Texterkennung liest
#          die Teilenummer, feste Regeln leiten Titel und Preis aus den
#          eBay-Vergleichsangeboten ab. Keine Konten, keine Rechnung.
#   cli    Kostenlos im Rahmen eines bestehenden Claude-Abos. Setzt voraus,
#          dass das Programm "claude" installiert ist.
#   api    KOSTENPFLICHTIG pro Foto. Beste Erkennung bei schwierigen Fotos.
#          Braucht einen ANTHROPIC_API_KEY.
#   auto   Nimmt api, wenn ein Key da ist, sonst cli, sonst lokal.
AUTOLISTER_MODUS=lokal

# Nur für die Betriebsarten "api" bzw. "auto" nötig:
ANTHROPIC_API_KEY=
AUTOLISTER_VISION_MODEL=claude-opus-4-8
AUTOLISTER_TEXT_MODEL=claude-opus-4-8

# --- Texterkennung (Betriebsart "lokal") -------------------------------------
# Auflösung fürs Lesen der Teilenummer. Eingestanzte Nummern sind kontrastarm,
# deshalb bewusst hoch — Verkleinern kostet hier messbar Trefferquote.
AUTOLISTER_OCR_MAX_EDGE=4200

# --- Bilder ------------------------------------------------------------------
AUTOLISTER_VISION_MAX_EDGE=1568
AUTOLISTER_VISION_JPEG_QUALITY=85
AUTOLISTER_UPLOAD_JPEG_QUALITY=92

# Wie viele Teile gleichzeitig ausgewertet werden
AUTOLISTER_VISION_PARALLEL=4

# --- Browser und Dienste -----------------------------------------------------
# 1 = Browser unsichtbar. Standard 0: sichtbar, damit eBay weniger misstrauisch
# ist und du bei einer Sicherheitsabfrage eingreifen kannst.
AUTOLISTER_HEADLESS=0

# Port der Upload-Website
AUTOLISTER_WEBAPP_PORT=8790

# Sekunden Ruhe im Eingang, bevor die Verarbeitung startet
AUTOLISTER_SETTLE_SECONDS=25

# --- Web-App (Netlify + Supabase) -------------------------------------------
# Nur nötig, wenn die Fotos vom Handy statt aus dem Eingang-Ordner kommen.
# Einrichtung Schritt für Schritt: siehe WEBAPP.md
#
# ACHTUNG: SUPABASE_SERVICE_KEY umgeht alle Zugriffsregeln der Datenbank.
# Er gehört ausschliesslich hierher - niemals in web/config.js, denn die
# Seite ist oeffentlich abrufbar.
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fotos
AUTOLISTER_POLL_SEKUNDEN=30
